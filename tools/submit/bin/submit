main() {
    cd $ROOT

    # Use environment-aware file locations when available.
    test_patch=${SWE_AGENT_TEST_PATCH_FILE:-/root/test.patch}
    model_patch=${SWE_AGENT_MODEL_PATCH_FILE:-/root/model.patch}

    if [ -s "$test_patch" ]; then
        git apply -R < "$test_patch"
    fi

    git add -A
    git diff --cached > "$model_patch"
    echo "<<SWE_AGENT_SUBMISSION>>"
}

main "$@"
